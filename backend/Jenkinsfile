                    // docker.withRegistry("${env.REGISTRY_URL}","${env.QA_DH_CREDENTIALS}"){
                    //     docker.image("${env.BACKEND_IMAGE_QA}:${GIT_COMMIT}").push()
                    // }

                    promoteImage("${env.BACKEND_IMAGE_DEV}","${env.BACKEND_IMAGE_QA}","${env.DEV_DH_CREDENTIALS}","${env.QA_DH_CREDENTIALS}")

                    // withKubeConfig(credentialsId: 'eks-kubeconfig', namespace: 'employee-qa'){
                    //     sh 'echo deploying to employee-qa namespace...'
                    //     sh "sed -i -e 's/{{ENV}}/${params.Environment}/g' -e 's/{{COMMITID}}/${env.GIT_COMMIT}/g' kube/backend-deployment.yml "
                    //     sh 'kubectl apply -f kube/configmap.yml'
                    //     sh 'kubectl apply -f kube/db-secret.yml'
                    //     sh 'kubectl apply -f kube/mysql-deployment.yml'
                    //     sh 'kubectl apply -f kube/mysql-service.yml'
                    //     sh 'kubectl apply -f kube/backend-deployment.yml'
                    //     sh 'kubectl apply -f kube/backend-service.yml'
                    // }

                    deployToEks("${env.CLUSTER_CREDENTIALS}","${env.QA_NS}","${params.Environment}")

                }
            }
        }

        stage("promote image QA to UAT"){
            when {
                expression{
                    params.Environment == "uat"
                }
            }
            steps{
                script{
                    // docker.withRegistry("${env.REGISTRY_URL}","${env.QA_DH_CREDENTIALS}"){
                    //     docker.image("${env.BACKEND_IMAGE_QA}:${GIT_COMMIT}").pull()
                    // }


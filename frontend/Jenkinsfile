                    // docker.withRegistry("${env.REGISTRY_URL}","${env.DEV_DH_CREDENTIALS}"){
                    //     docker.image("${env.FRONTEND_IMAGE_DEV}:${GIT_COMMIT}").pull()
                    // }

                    // sh "docker tag ${env.FRONTEND_IMAGE_DEV}:${GIT_COMMIT} ${env.FRONTEND_IMAGE_QA}:${GIT_COMMIT}"

                    // docker.withRegistry("${env.REGISTRY_URL}","${env.QA_DH_CREDENTIALS}"){
                    //     docker.image("${env.FRONTEND_IMAGE_QA}:${GIT_COMMIT}").push()
                    // }

                    promoteImage("${env.FRONTEND_IMAGE_DEV}","${env.FRONTEND_IMAGE_QA}","${env.DEV_DH_CREDENTIALS}","${env.QA_DH_CREDENTIALS}")

                    // withKubeConfig(credentialsId: 'eks-kubeconfig', namespace: 'employee-qa'){
                    //     sh 'echo deploying to employee-qa namespace...'
                    //     sh "sed -i -e 's/{{ENV}}/${params.Environment}/g' -e 's/{{COMMITID}}/${env.GIT_COMMIT}/g' kube/frontend-deployment.yml "
                    //     sh 'kubectl apply -f kube/frontend-deployment.yml'
                    //     sh 'kubectl apply -f kube/frontend-service.yml'
                    //     sh 'kubectl apply -f kube/ingress.yml'
                    // }

                    deployToEks("${env.CLUSTER_CREDENTIALS}","${env.QA_NS}","${params.Environment}")
                }
            }
        }

        stage("promote image QA to UAT"){
            when {
                expression{
                    params.Environment == "uat"
                }
            }
            steps{
                script{
                    // docker.withRegistry("${env.REGISTRY_URL}","${env.QA_DH_CREDENTIALS}"){
                    //     docker.image("${env.FRONTEND_IMAGE_QA}:${GIT_COMMIT}").pull()
                    // }

                    // sh "docker tag ${env.FRONTEND_IMAGE_QA}:${GIT_COMMIT} ${env.FRONTEND_IMAGE_UAT}:${GIT_COMMIT}"

                    // docker.withRegistry("${env.REGISTRY_URL}","${env.UAT_DH_CREDENTIALS}"){
                    //     docker.image("${env.FRONTEND_IMAGE_UAT}:${GIT_COMMIT}").push()
                    // }

                    promoteImage("${env.FRONTEND_IMAGE_QA}","${env.FRONTEND_IMAGE_UAT}","${env.QA_DH_CREDENTIALS}","${env.UAT_DH_CREDENTIALS}")

                    // withKubeConfig(credentialsId: 'eks-kubeconfig', namespace: 'employee-uat'){
                    //     sh 'echo deploying to employee-uat namespace...'
                    //     sh "sed -i -e 's/{{ENV}}/${params.Environment}/g' -e 's/{{COMMITID}}/${env.GIT_COMMIT}/g' kube/frontend-deployment.yml "
                    //     sh 'kubectl apply -f kube/frontend-deployment.yml'
                    //     sh 'kubectl apply -f kube/frontend-service.yml'
                    //     sh 'kubectl apply -f kube/ingress.yml'
                    // }

                    deployToEks("${env.CLUSTER_CREDENTIALS}","${env.UAT_NS}","${params.Environment}")
                }
            }
        }

        stage("approval for prod"){
            when{
                expression{
                    params.Environment == 'prod'
                }
            }
            steps{
                input message: 'Promote the image from UAT to PROD?',
                      ok: "Promote to PROD"
            }
        }
        

        stage("Promote image from UAT to PROD"){
            when{
                expression{
                    params.Environment == "prod"
                }
            }
            steps{
                script{
                    // docker.withRegistry("${env.REGISTRY_URL}","${env.UAT_DH_CREDENTIALS}"){
                    //     docker.image("${env.FRONTEND_IMAGE_UAT}:${GIT_COMMIT}").pull()
                    // }


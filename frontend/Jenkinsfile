        choice(
            name: 'Environment',
            choices: ["dev","qa","uat","prod"],
            description: "Select deployment environment"
        )
    }

    stages{

        stage("build & push"){
            when {
                expression{
                    params.Environment == "dev"
                }
            }
            steps{
                script{

                    // def frontend= docker.build("${env.FRONTEND_IMAGE_DEV}:${GIT_COMMIT}","./frontend")

                    // docker.withRegistry("${env.REGISTRY_URL}","${env.DEV_DH_CREDENTIALS}"){
                    //     frontend.push()
                    // }

                    buildAndPushImage("${env.FRONTEND_IMAGE_DEV}","${env.DEV_DH_CREDENTIALS}", "${env.BUILD_CONTEXT}")

                    // withKubeConfig(credentialsId: 'eks-kubeconfig', namespace: 'employee-dev'){
                    //     sh 'echo deploying to employee-dev namespace...'
                    //     sh "sed -i -e 's/{{ENV}}/${params.Environment}/g' -e 's/{{COMMITID}}/${env.GIT_COMMIT}/g' kube/frontend-deployment.yml "
                    //     sh 'kubectl apply -f kube/frontend-deployment.yml'
                    //     sh 'kubectl apply -f kube/frontend-service.yml'
                    //     sh 'kubectl apply -f kube/ingress.yml'
                    // }

                    deployToEks("${env.CLUSTER_CREDENTIALS}","${env.DEV_NS}","${params.Environment}")
                }
            }
        }

        stage("promote image DEV to QA"){
            when{
                expression{
                    params.Environment == "qa"
